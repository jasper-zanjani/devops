resources
| where type =~ 'microsoft.network/virtualnetworks'
| mv-expand subnet = properties.subnets
| where tostring(subnet.properties.addressPrefix) == "10.20.5.0/24"
    or array_contains(subnet.properties.addressPrefixes, "10.20.5.0/24")
| project
    subscriptionId,
    resourceGroup,
    vnetName = name,
    subnetName = tostring(subnet.name)
