classDiagram
  Vault o--> Item
  Item *--> Policy
  Policy *--> PolicyType
  Vault o--> Job
  Job *--> OperationType

  class Item {
    Policy
  }

  class Job {
    OperationType
  }

  class OperationType {
    <<enum>>
    BACKUP
    CONFIGUREBACKUP
    DELETEBACKUPDATA
    DISABLEBACKUP
    RESTORE
